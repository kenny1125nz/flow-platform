{
  "name": "flow-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "test": "npm run build && node --test dist/test/*.test.js",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "npm --prefix web run dev",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "start": "node dist/src/server/main.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "fastify": "^5.12.8"
  }
}
